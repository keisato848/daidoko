{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent/hook-pretool-guard.mjs"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent/hook-pretool-edit-guard.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent/hook-posttool-docs-reminder.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent/hook-stop-docs-guard.mjs"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent/hook-user-prompt-router.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent/hook-session-start.mjs"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "keisato-harness": {
      "source": {
        "source": "directory",
        "path": "C:/Projects/claude-harness"
      }
    }
  },
  "enabledPlugins": {
    "harness@keisato-harness": true
  },
  "env": {
    "HARNESS_ROOT": "C:/Projects/claude-harness",
    "HARNESS_GEMINI_MODE": "geminiwrite"
  }
}
