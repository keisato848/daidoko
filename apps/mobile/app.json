{
  "expo": {
    "name": "だいどこ",
    "slug": "daidoko",
    "version": "1.12.1",
    "orientation": "default",
    "scheme": "daidoko",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0805",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0805"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.daidoko.app",
      "buildNumber": "10031",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": ["ja", "en"]
      },
      "associatedDomains": ["applinks:daidoko-production.up.railway.app"],
      "appleTeamId": "VY7SNHS2BY",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.daidoko.app"]
      }
    },
    "android": {
      "package": "com.daidoko.app",
      "versionCode": 10031,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0805"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "daidoko-production.up.railway.app",
              "pathPrefix": "/r/"
            },
            {
              "scheme": "https",
              "host": "daidoko-production.up.railway.app",
              "pathPrefix": "/b/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.20"
          }
        }
      ],
      "./plugins/withKotlinMetadataSkip",
      "./plugins/withDaidokoBackupRules",
      "./plugins/withDaidokoShortcuts",
      [
        "expo-image-picker",
        {
          "photosPermission": "レシピ写真を選択するために写真ライブラリへのアクセスを使用します。",
          "cameraPermission": "レシピ写真を撮影するためにカメラを使用します。",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "バーコード（JAN）を読み取るためにカメラを使用します。",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withDaidokoOcr",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2633806931583277~2829239666",
          "iosAppId": "ca-app-pub-2633806931583277~1080328085",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ShoppingList",
              "label": "買い物リスト",
              "description": "買い物リストの未購入品を表示します",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "180dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "ae12a2e5-cd4a-4dd4-a5f5-741511a52281"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "keisato848"
  }
}
