# サーバー設定
PORT=3000
NODE_ENV=development

# データベース
DATABASE_URL=postgresql://daidoko:password@localhost:5432/daidoko_dev

# JWT（RS256 鍵ペア — 本番では外部シークレット管理ツールを使うこと）
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# S3 互換ストレージ（MinIO ローカル or Cloudflare R2）
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=daidoko-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI API（料理写真レシピ推論 / OCR テキスト構造化）
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.5-flash          # 任意（既定: gemini-2.5-flash）
# INFER_DAILY_LIMIT=20                    # 任意（1クライアント(IP)/日の推論上限。**0 は上限なし**）
# INFER_GLOBAL_DAILY_LIMIT=200           # 任意（全体/日の推論上限＝コスト上限。**0 は上限なし**）
# GEMINI_THINKING_BUDGET=auto            # 任意（既定は 0 ＝思考オフ。auto でモデル既定に戻す）
#   思考トークンは課金上「出力」に計上され、実測ではコストを支配していた（¥0.85 → ¥0.35）。
#   品質差は測定で 0.04 以内だったため既定をオフにしている。戻すのはこの変数だけでよく、
#   再デプロイは要らない（docs/レシピ推論の評価設計.md §9・src/lib/thinking-budget.ts）。
# 手順のイラスト AI 生成（docs/レシピ表紙AI生成設計.md §8）
# STEP_IMAGE_MODEL=gemini-3.1-flash-lite-image  # 任意（未設定なら COVER_IMAGE_MODEL → Lite の順）
# STEP_IMAGE_GLOBAL_DAILY_LIMIT=10        # 任意（全体/日。表紙の COVER_POOL とは別プール）
# STEP_IMAGE_DAILY_LIMIT=10               # 任意（1クライアント(IP)/日。一括生成が続けて叩くので表紙より緩い）
#   **どの *_DAILY_LIMIT も 0 以下は「上限なし」**。コストを止めるつもりで 0 を入れると天井が外れる

# ANTHROPIC_API_KEY=your_key_here

# Sentry（エラー監視 — 省略可）
# SENTRY_DSN=https://xxx@sentry.io/xxx
