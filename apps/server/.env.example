# サーバー設定
PORT=3000
NODE_ENV=development

# データベース
DATABASE_URL=postgresql://daidoko:password@localhost:5432/daidoko_dev

# JWT（RS256 鍵ペア — 本番では外部シークレット管理ツールを使うこと）
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# S3 互換ストレージ（MinIO ローカル or Cloudflare R2）
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=daidoko-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI API（料理写真レシピ推論 / OCR テキスト構造化）
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.5-flash          # 任意（既定: gemini-2.5-flash）
# INFER_DAILY_LIMIT=20                    # 任意（1クライアント(IP)/日の推論上限。0で無効）
# INFER_GLOBAL_DAILY_LIMIT=200           # 任意（全体/日の推論上限＝コスト上限。0で無効）
# GEMINI_THINKING_BUDGET=auto            # 任意（既定は 0 ＝思考オフ。auto でモデル既定に戻す）
#   思考トークンは課金上「出力」に計上され、実測ではコストを支配していた（¥0.85 → ¥0.35）。
#   品質差は測定で 0.04 以内だったため既定をオフにしている。戻すのはこの変数だけでよく、
#   再デプロイは要らない（docs/レシピ推論の評価設計.md §9・src/lib/thinking-budget.ts）。
# レシピの「イメージ」AI 生成（docs/レシピ表紙AI生成設計.md）
# COVER_IMAGE_MODEL=gemini-3.1-flash-lite-image   # 任意（既定。評価の結果で差し替える。アプリのリリース不要）
# COVER_IMAGE_GLOBAL_DAILY_LIMIT=10       # 任意（全体/日。1 枚 ≒¥5.0 なので月最大 ¥1,550。0で無効）
# COVER_IMAGE_DAILY_LIMIT=5               # 任意（1クライアント(IP)/日。0で無効）
# COVER_IMAGE_CUISINE_HINT=0              # 任意（既定 off。on にすると盛り付けの1行を料理名・タグ・材料からの
#   出自推定で決める（設計 §2-1 C-1）。§7-2 の目視評価で現行以上と確認してから on にすること）

# ANTHROPIC_API_KEY=your_key_here

# Sentry（エラー監視 — 省略可）
# SENTRY_DSN=https://xxx@sentry.io/xxx
